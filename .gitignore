# Core Terraform directories and local plugin caches
.terraform/

# Distributed TF State files (Should be stored in a remote backend instead)
*.tfstate
*.tfstate.*

# Crash logs (generated only if Terraform crashes)
crash.log
crash.*.log

# Exclude all variable files as they often contain sensitive data/credentials
*.tfvars
*.tfvars.json

# Exclude local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Exclude generated execution plans
*tfplan*
