{"nodes": [{"id": "claude_skills_backend_developer_skill_backend_developer", "label": "Backend Developer", "file_type": "document", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_nestjs", "label": "NestJS", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default framework for apps/backend. The skill targets NestJS 11 with the Express adapter."}, {"id": "claude_skills_backend_developer_skill_express", "label": "Express", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_typescript", "label": "TypeScript", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_prisma", "label": "Prisma", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_postgres", "label": "Postgres", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_redis", "label": "Redis", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_bullmq", "label": "BullMQ", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_backend_developer_skill_apps_backend", "label": "apps/backend", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "# Backend Developer (NestJS-first)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The live NestJS backend this skill is written for."}, {"id": "claude_skills_backend_developer_skill_apiresponseexception", "label": "ApiResponseException", "file_type": "concept", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## HoneBill repo conventions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed exception that carries an exact HTTP body. It exists so a route can match the legacy error JSON without building the response inside a service."}, {"id": "claude_skills_backend_developer_skill_dynamic_modules", "label": "Dynamic modules", "file_type": "rationale", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## NestJS principles (the short version)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forRoot, forRootAsync, and register are for configurable or optional wiring, such as registering BullMQ workers only when QUEUE_ENABLED=true."}, {"id": "claude_skills_backend_developer_skill_keep_layers_honest", "label": "Keep layers honest", "file_type": "rationale", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## What makes a good backend developer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controllers translate HTTP, services hold business rules, and infra modules wrap external systems. When logic leaks across layers, tests get hard and bugs hide."}, {"id": "claude_skills_backend_developer_skill_one_feature_one_module", "label": "One feature one module", "file_type": "rationale", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## NestJS principles (the short version)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A feature module owns its controller, service, and DTOs. Import dependencies explicitly and export only what others need. @Global() is only for true cross-cutting infrastructure so the dependency graph stays readable."}, {"id": "claude_skills_backend_developer_skill_service_file_naming", "label": "Service file naming", "file_type": "rationale", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## HoneBill repo conventions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "*.service.ts holds services and *.util.ts holds pure helpers. WalletService lives in wallet.util.ts today; do not copy that."}, {"id": "claude_skills_backend_developer_skill_assume_failure", "label": "Assume failure", "file_type": "rationale", "source_file": ".claude/skills/backend-developer/SKILL.md", "source_location": "## What makes a good backend developer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Networks time out, Redis restarts, the same webhook arrives twice, and two requests race. The usual answers are idempotency keys, unique constraints, transactions, timeouts, and retries with backoff."}], "edges": [{"source": "claude_skills_backend_developer_skill_backend_developer", "target": "claude_skills