s/SKILL.md", "source_location": "Clawback Tokens", "weight": 1.0}, {"source": "agents_skills_assets_skill_issuer_flags", "target": "agents_skills_assets_skill_sac", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Best Practices", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0001", "target": "agents_skills_assets_skill_stellar_assets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0001 (stellar.toml)", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0010", "target": "agents_skills_assets_skill_stellar_assets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0010 (Web Authentication)", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0024", "target": "agents_skills_assets_skill_stellar_assets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0024 (Hosted Deposit/Withdrawal)", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0045", "target": "agents_skills_assets_skill_sep0010", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0045 (Web Auth for Contract Accounts)", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0045", "target": "agents_skills_dapp_smart_accounts_smart_account_kit", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0045 (Web Auth for Contract Accounts)", "weight": 1.0}, {"source": "agents_skills_assets_skill_sep0050", "target": "agents_skills_assets_skill_openzeppelin_stellar_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP-0050 (Non-Fungible Tokens)", "weight": 1.0}, {"source": "agents_skills_assets_skill_usdt0", "target": "agents_skills_assets_skill_sac", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "When to Use What", "weight": 1.0}, {"source": "agents_skills_assets_skill_usdt0", "target": "agents_skills_assets_skill_stellar_assets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "When to Use What", "weight": 1.0}, {"source": "agents_skills_assets_skill_usdt0", "target": "agents_skills_assets_skill_sep0001", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Best Practices", "weight": 1.0}, {"source": "agents_skills_assets_skill_liquidity_pool_shares", "target": "agents_skills_assets_skill_trustlines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Remove Trustline", "weight": 1.0}, {"source": "agents_skills_assets_skill_liquidity_pool_shares", "target": "agents_skills_assets_skill_cap0038", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Remove Trustline", "weight": 1.0}, {"source": "agents_skills_assets_skill_claimable_balances", "target": "agents_skills_assets_skill_trustlines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Remove Trustline", "weight": 1.0}, {"source": "agents_skills_assets_skill_claimable_balances", "target": "agents_skills_assets_skill_clawback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Remove Trustline", "weight": 1.0}, {"source": "agents_skills_assets_skill_trustlines", "target": "agents_skills_dapp_skill_horizon", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "Check Trustline Status", "weight": 1.0}], "hyperedges": [{"id": "agents_skills_assets_skill_classic_asset_model", "label": "Classic asset, trustline, and SAC choice", "nodes": ["agents_skills_assets_skill_stellar_assets", "agents_skills_assets_skill_trustlines", "agents_skills_assets_skill_sac", "agents_skills_assets_skill_issuer_flags", "agents_skills_assets_skill_custom_contract_tokens"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "When to Use What"}, {"id": "agents_skills_assets_skill_sep_standards", "label": "SEP standards for assets", "nodes": ["agents_skills_assets_skill_sep0001", "agents_skills_assets_skill_sep0010", "agents_skills_assets_skill_sep0024", "agents_skills_assets_skill_sep0045", "agents_skills_assets_skill_sep0050"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/assets/SKILL.md", "source_location": "SEP Standards for Assets"}]}