{"nodes": [{"id": "agents_skills_dapp_smart_accounts_smart_account_kit", "label": "Smart Account Kit", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Smart Accounts (Passkey Wallets)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwordless smart wallets from the smart-account-kit package. Authorization is OpenZeppelin context rules plus an auth digest on the audited stellar-contracts account. Use it when you need context rules, thresholds, or spending limits. It is a sibling of Passkey Kit, not a newer version, and the two are not drop-in compatible. Neither project declares the other deprecated. Signers include WebAuthn passkeys (secp256r1), Ed25519 keys, and policies. Sessions restore from IndexedDB without a prompt."}, {"id": "agents_skills_dapp_smart_accounts_passkey_kit", "label": "Passkey Kit", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Choosing between the two kits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sibling SDK to Smart Account Kit with a flat multi-signer Signatures map. Choose it when that flat model is enough. Not drop-in compatible with Smart Account Kit's context-rule accounts, and neither README deprecates the other."}, {"id": "agents_skills_dapp_smart_accounts_openzeppelin_relayer", "label": "OpenZeppelin Relayer", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Fee Sponsorship with OpenZeppelin Relayer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also called Stellar Channels Service. Submits gasless transactions with Stellar's native fee bump so the user does not need XLM for fees. Replaces the deprecated Launchtube service. Client package is @openzeppelin/relayer-plugin-channels. Hosted testnet is https://channels.openzeppelin.com/testnet; production is self-hosted with Docker. Not part of the JS SDK."}, {"id": "agents_skills_dapp_smart_accounts_webauthn", "label": "WebAuthn", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Smart Accounts (Passkey Wallets)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passkey standard Smart Account Kit uses for passwordless authentication. The kit is configured with a WebAuthn verifier contract address."}, {"id": "agents_skills_dapp_smart_accounts_launchtube", "label": "Launchtube", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Fee Sponsorship with OpenZeppelin Relayer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deprecated fee-sponsorship service. OpenZeppelin Relayer replaces it and uses Stellar fee bumps instead."}, {"id": "agents_skills_dapp_smart_accounts_lobstr", "label": "LOBSTR", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Key Features", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External wallet that Smart Account Kit can connect through an adapter, alongside Freighter."}, {"id": "agents_skills_dapp_smart_accounts_openzeppelin_stellar_contracts", "label": "OpenZeppelin Stellar Contracts", "file_type": "concept", "source_file": ".agents/skills/dapp/smart-accounts.md", "source_location": "Choosing between the two kits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audited account implementation Smart Account Kit builds on. Context rules and an auth digest live in OpenZeppelin/stellar-contracts. Reach for this kit when those rules, thresholds, or spending limits are required."}], "edges": [{"source": "agents_skills_dapp_smart_accounts_smart_account_kit", "target": "agents_skills_dapp_smart_accounts_passkey_kit"