{"nodes": [{"id": "docs_backend_rebuild_05_sms_test_porting", "label": "Phase 5 SMS test porting", "file_type": "document", "source_file": "docs/backend-rebuild/05-sms-test-porting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified 2026-11-01. Legacy files stayed unchanged. Jest groups related assertions into parameterized tests instead of keeping node:test names one for one. The porting task is complete for the mapped cases, but Phase 5 stays open until TextBee fallback, a provider-originated callback, production-worker retry scheduling, and a funded on-chain voucher settlement are verified. This run sent no real SMS and submitted no payment."}, {"id": "docs_backend_rebuild_05_sms_test_porting_sms_security_test", "label": "sms-security.test.ts", "file_type": "concept", "source_file": "docs/backend-rebuild/05-sms-test-porting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy cases for HMAC prefixes, tampered signatures, timestamp drift, body limits, phone masking, and recursive redaction of Stellar, QStash, and bearer secrets."}, {"id": "docs_backend_rebuild_05_sms_test_porting_sms_delivery_test", "label": "sms-delivery.test.ts", "file_type": "concept", "source_file": "docs/backend-rebuild/05-sms-test-porting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy cases for retryable 408/429/5xx versus permanent 4xx, fallback gateway and SIM selection, Philippine number normalization, tester OTP, and device health."}, {"id": "docs_backend_rebuild_05_sms_test_porting_offline_voucher_security_test", "label": "offline-voucher-security.test.ts", "file_type": "concept", "source_file": "docs/backend-rebuild/05-sms-test-porting.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale"