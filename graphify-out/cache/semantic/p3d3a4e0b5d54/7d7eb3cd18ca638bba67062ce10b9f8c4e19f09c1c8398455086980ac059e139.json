{"nodes": [{"id": "apps_legacy_backend_public_assets_glow_glow_translucent_glow_blob", "label": "Translucent glow blob", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "517\u00d7430 8-bit sRGB PNG with an alpha channel. One soft blob fills most of the frame. It is not a screenshot, logo, chart, or diagram. Preview black is empty transparency. No pixel is fully opaque; the densest point is alpha 246 near the upper middle."}, {"id": "apps_legacy_backend_public_assets_glow_glow_blue_to_cream_gradient", "label": "Blue-to-cream vertical gradient", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-alpha color runs from steel blue around RGB(53, 91, 127) in the upper body, through gray-olive in the middle, to pale butter yellow around RGB(231, 214, 149) in the lower body."}, {"id": "apps_legacy_backend_public_assets_glow_glow_soft_alpha_falloff", "label": "Soft alpha falloff", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opacity feathers outward from the upper-middle. Center-column alpha rises from 0 at the top to about 245 in the blue, then falls through the yellow to 0 at the bottom. About 50657 pixels are alpha 0 and none are alpha 255."}, {"id": "apps_legacy_backend_public_assets_glow_glow_chromatic_speckled_fringe", "label": "Chromatic speckled fringe", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The outline is a noisy prismatic rim of red, green, cyan, blue, and yellow specks, not a smooth contour. A left-edge sample is warm orange at alpha 4; a right-edge sample is blue-purple at alpha 4."}, {"id": "apps_legacy_backend_public_assets_glow_glow_irregular_rounded_silhouette", "label": "Irregular rounded silhouette", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wider than tall and squircle-like, with a lumpy left side. Pixels with alpha above 8 sit roughly in x 36\u2013481 and y 28\u2013402."}, {"id": "apps_legacy_backend_public_assets_glow_glow_transparent_surround", "label": "Transparent surround", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The four corners are RGBA(0, 0, 0, 0). Only the blob is painted, so the asset is meant to be composited over a page."}, {"id": "apps_legacy_backend_public_assets_glow_glow_ambient_ui_glow", "label": "Ambient UI glow", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A text-free feathered color blob stored under public/assets/glow. It reads as a decorative background light for the legacy web UI. This file does not show which page composites it."}], "edges": [{"source": "apps_legacy_backend_public_assets_glow_glow_translucent_glow_blob", "target": "apps_legacy_backend_public_assets_glow_glow_blue_to_cream_gradient", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/glow/glow.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_glow_glow_translucent_glow_blob", "ta