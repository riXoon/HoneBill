{"nodes": [{"id": "apps_legacy_backend_public_assets_logo_light", "label": "Logo light: navy rounded-square icon, white winged P, sky-blue stem tip, no wordmark", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visible mark only. A dark navy rounded square sits inside a black surround. Centered on the navy is a bold white capital-P letterform. The top bar extends left into a wing of two left-pointing feathers (longer upper feather, shorter lower feather). The bowl is a thick rounded loop on the right; the counter shows navy. The stem sweeps down and slightly left and ends in a rounded tip. The lower stem is light sky blue, divided from the white by a near-horizontal edge. A soft shadow sits under the white shape. No brand name, tagline, or other readable wordmark is present."}, {"id": "apps_legacy_backend_public_assets_logo_light_winged_p", "label": "Winged letter P", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only letter-like form. It reads as a capital P: horizontal top bar, right-hand bowl, and a descending stem. It is a pictorial mark, not spelled text."}, {"id": "apps_legacy_backend_public_assets_logo_light_left_wing", "label": "Left wing on the P bar", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two tapered feathers continue the top stroke to the left. The upper feather is longer; the lower feather is shorter. Both point left."}, {"id": "apps_legacy_backend_public_assets_logo_light_p_bowl", "label": "Rounded P bowl", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thick white loop on the right of the mark. The opening of the counter faces left and shows the navy field."}, {"id": "apps_legacy_backend_public_assets_logo_light_sky_blue_stem_tip", "label": "Sky-blue stem tip", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lower portion of the stem is light sky blue, not navy. The white-to-blue split is nearly horizontal. The tip is rounded and leans slightly left."}, {"id": "apps_legacy_backend_public_assets_logo_light_navy_rounded_square", "label": "Dark navy rounded square", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The icon field is a deep navy rounded square. The margin outside that rounded square renders black."}, {"id": "apps_legacy_backend_public_assets_logo_light_no_wordmark", "label": "No readable wordmark", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No spelled name, initials beside the mark, or tagline. The pictorial P is the only letterform."}, {"id": "apps_legacy_backend_public_assets_logo_light_app_icon", "label": "Rounded-square app icon", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inferred from the centered mark on a large-radius rounded square. The image does not name a platform."}, {"id": "apps_legacy_backend_public_assets_logo_light_flight_motif", "label": "Flight motif", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inferred from the wing drawn on the letter. No word such as flight or speed is printed."}], "edges": [{"source": "apps_legacy_backend_public_assets_logo_light", "target": "apps_legacy_backend_public_assets_logo_light_winged_p", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_logo_light", "target": "apps_legacy_backend_public_assets_logo_light_navy_rounded_square", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_logo_light", "target": "apps_legacy_backend_public_assets_logo_light_no_wordmark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_logo_light_winged_p", "target": "apps_legacy_backend_public_assets_logo_light_left_wing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_logo_light_winged_p", "target": "apps_legacy_backend_public_assets_logo_light_p_bowl", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/logo-light.png", "source_location": null