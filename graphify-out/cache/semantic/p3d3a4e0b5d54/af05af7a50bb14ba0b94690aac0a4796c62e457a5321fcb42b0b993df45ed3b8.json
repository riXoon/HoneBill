{"nodes": [{"id": "agents_skills_dapp_skill_stellar_dapp", "label": "Stellar dApp", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Stellar dApp / Frontend", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep one SDK instance for Horizon, Soroban RPC, and transaction building, and split client and server in Next.js. Show signing and confirmation state, and block double submission. Mainnet RPC comes from an env-provided URL; testnet uses the public Horizon and Soroban endpoints."}, {"id": "agents_skills_dapp_skill_freighter", "label": "Freighter", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Freighter (Primary Browser Wallet)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary browser wallet, via @stellar/freighter-api, which is not part of @stellar/stellar-sdk. getAddress stays empty until requestAccess has been granted; a non-empty address means the app is already authorized. Signing returns signed transaction XDR. Handle a missing extension, user rejection, and a wallet on the wrong network."}, {"id": "agents_skills_dapp_skill_stellar_wallets_kit", "label": "Stellar Wallets Kit", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Stellar Wallets Kit (Multi-Wallet)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-wallet kit. v2 is a static singleton installed from JSR as @creit-tech/stellar-wallets-kit, not from the old npm scope @creit.tech/stellar-wallets-kit. init once, then authModal replaces v1 openModal. defaultModules loads wallets that need no extra setup; WalletConnect, Ledger, and Trezor must be added explicitly. npm updates are expected to stop. Not part of the JS SDK."}, {"id": "agents_skills_dapp_skill_wallet_standard", "label": "Wallet Standard", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named in the skill description alongside Freighter and Stellar Wallets Kit. This file does not describe the Wallet Standard API."}, {"id": "agents_skills_dapp_skill_stellar_sdk", "label": "@stellar/stellar-sdk", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Recommended Dependencies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript SDK for browser and Node.js. v16 requires Node.js 22 or newer, is ESM-first, uses native fetch instead of axios, and folded @stellar/stellar-base into this package. Keeping the base package installed breaks instanceof checks. Wallet kits, passkey accounts, and the OpenZeppelin relayer are separate packages. Official docs also publish llms.txt bundles for agents."}, {"id": "agents_skills_dapp_skill_stellar_base", "label": "@stellar/stellar-base", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Recommended Dependencies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Former low-level package. As of stellar-sdk v16 it is folded into @stellar/stellar-sdk. Uninstall it and change imports over, because keeping both breaks instanceof checks."}, {"id": "agents_skills_dapp_skill_contract_client", "label": "contract.Client", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical JS way to call a Stellar contract. It reads the interface from the network so methods are called by name and return an AssembledTransaction. Preview is a free simulation; signAndSend submits and polls. Build ScVals by hand only on the low-level path. Use Contract.call plus prepareTransaction only when batching a contract call with classic operations. Multi-party auth uses needsNonInvokerSigningBy and signAuthEntries. Node scripts use contract.basicNodeSigner instead of a browser wallet."}, {"id": "agents_skills_dapp_skill_horizon", "label": "Horizon", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic operation path via StellarSdk.Horizon.Server. Testnet is https://horizon-testnet.stellar.org and mainnet is https://horizon.stellar.org. Submit classic transactions here. Transactions that invoke a host function go to Soroban RPC instead."}, {"id": "agents_skills_dapp_skill_soroban_rpc", "label": "Soroban RPC", "file_type": "concept", "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RPC for smart-contract transactions, via StellarSdk.rpc.Server. Testnet public URL is https://soroban-testnet.stellar.org. Mainnet URL must be set from a provider in NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL. sendTransaction plus pollTransaction replaces a hand-rolled poll. prepareTransaction simulates and applies footprint, auth, and fees."}], "edges": [{"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_freighter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Wallet Integration", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_stellar_wallets_kit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Wallet Integration", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_wallet_standard", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_stellar_sdk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Recommended Dependencies", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_sdk", "target": "agents_skills_dapp_skill_stellar_base", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Recommended Dependencies", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_contract_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_contract_client", "target": "agents_skills_dapp_skill_stellar_sdk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_horizon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "weight": 1.0}, {"source": "agents_skills_dapp_skill_horizon", "target": "agents_skills_dapp_skill_stellar_sdk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_dapp", "target": "agents_skills_dapp_skill_soroban_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "weight": 1.0}, {"source": "agents_skills_dapp_skill_soroban_rpc", "target": "agents_skills_dapp_skill_stellar_sdk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "SDK Initialization", "weight": 1.0}, {"source": "agents_skills_dapp_skill_contract_client", "target": "agents_skills_dapp_skill_soroban_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_contract_client", "target": "agents_skills_dapp_skill_freighter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_contract_client", "target": "agents_skills_dapp_skill_stellar_wallets_kit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Smart Contract Invocation (`contract.Client`)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_stellar_wallets_kit", "target": "agents_skills_dapp_skill_freighter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dapp/SKILL.md", "source_location": "Stellar Wallets Kit (Multi-Wallet)", "weight": 1.0}, {"source": "agents_skills_dapp_skill_freighter", "target": "agents_skills_dapp_skill_stellar_sdk", "relation": "conceptually_related_to", "confid