{"nodes": [{"id": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "label": "Stellar Smart Contracts", "file_type": "document", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guide for building Stellar smart contracts in Rust. Setup and the core workflow live here; storage, auth, testing, and security deep dives are companion files."}, {"id": "claude_skills_smart_contracts_skill_soroban", "label": "Soroban", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smart contracts on Stellar were formerly branded Soroban. The platform name is retired, but soroban-sdk and several tool names keep the prefix."}, {"id": "claude_skills_smart_contracts_skill_soroban_sdk", "label": "soroban-sdk", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The soroban-sdk major version tracks the protocol version (SDK 27 tracks protocol 27). That rule outlives any specific release. Pre-releases exist only during a protocol rollout and must be pinned with the exact version string."}, {"id": "claude_skills_smart_contracts_skill_protocol_27", "label": "Protocol 27", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This skill was written against protocol 27 (soroban-sdk v27, rs-soroban-env v27, stellar-cli v27). Networks upgrade by validator vote, testnet before mainnet, so pin the SDK major to the network you deploy to. Live protocol version comes from RPC getVersionInfo or Stellar Lab."}, {"id": "claude_skills_smart_contracts_skill_rs_soroban_env", "label": "rs-soroban-env", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_stellar_cli", "label": "Stellar CLI", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_network_limits", "label": "Network Limits", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numeric limits quoted in the skill are mainnet settings at time of writing and change by validator vote. Stellar Lab's Network Limits page and stellar network settings --network mainnet show the live values."}, {"id": "claude_skills_smart_contracts_skill_wasm32v1_none", "label": "wasm32v1-none", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only Wasm target the Stellar runtime supports. Requires Rust 1.84 or newer."}, {"id": "claude_skills_smart_contracts_skill_no_std", "label": "no_std", "file_type": "rationale", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#![no_std] is required. Use soroban_sdk types (String, Vec, Map, Symbol), not the Rust standard library."}, {"id": "claude_skills_smart_contracts_skill_env", "label": "Env", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything a contract can do hangs off Env. There is no I/O, no networking, and no clock beyond the ledger timestamp."}, {"id": "claude_skills_smart_contracts_skill_symbol", "label": "Symbol", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symbol is limited to 32 characters (a-zA-Z0-9_). symbol_short!() covers up to 9."}, {"id": "claude_skills_smart_contracts_skill_symbol_short", "label": "symbol_short!", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_contract_size_limit", "label": "128KB Contract Size Limit", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiled contract size is capped at 128KB. The cap is network-configured."}, {"id": "claude_skills_smart_contracts_skill_storage_ttl", "label": "Storage TTL", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storage is rented: every entry has a TTL and can be archived."}, {"id": "claude_skills_smart_contracts_skill_no_delegatecall", "label": "No delegatecall", "file_type": "rationale", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contracts have no delegatecall."}, {"id": "claude_skills_smart_contracts_skill_host_reentrancy_block", "label": "Host Reentrancy Block", "file_type": "rationale", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-contract reentrancy is blocked by the host."}, {"id": "claude_skills_smart_contracts_skill_constructor", "label": "__constructor", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs once, atomically, at deploy time. The function must be named __constructor. It does not run again on upgrade."}, {"id": "claude_skills_smart_contracts_skill_require_auth", "label": "require_auth", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_extend_ttl", "label": "extend_ttl", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "extend_ttl(threshold, extend_to) extends instance TTL so contract state is not archived."}, {"id": "claude_skills_smart_contracts_skill_contractevent", "label": "contractevent", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#[topic] fields become event topics. The other fields go in the data payload."}, {"id": "claude_skills_smart_contracts_skill_contracterror", "label": "contracterror", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_contracttype", "label": "contracttype", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_instance_storage", "label": "Instance Storage", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_stellar_contract_init", "label": "stellar contract init", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Project setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scaffolds a Cargo workspace with a contracts/ directory."}, {"id": "claude_skills_smart_contracts_skill_cdylib", "label": "cdylib", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Project setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "crate-type must include lib and cdylib. lib is needed for tests and fuzzing; cdylib is the contract WASM."}, {"id": "claude_skills_smart_contracts_skill_testutils", "label": "testutils", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Project setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dev-dependency feature of soroban-sdk for contract tests. Match the same SDK version as the contract dependency."}, {"id": "claude_skills_smart_contracts_skill_release_profile", "label": "Release Profile", "file_type": "rationale", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Project setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "opt-level z, overflow-checks, strip symbols, panic abort, codegen-units 1, and lto keep the release WASM small."}, {"id": "claude_skills_smart_contracts_skill_stellar_contract_build", "label": "stellar contract build", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Build, deploy, invoke", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds optimized WASM under target/wasm32v1-none/release. Optimization is on by default; --optimize=false turns it off."}, {"id": "claude_skills_smart_contracts_skill_stellar_contract_deploy", "label": "stellar contract deploy", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Build, deploy, invoke", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constructor arguments are passed after the -- separator."}, {"id": "claude_skills_smart_contracts_skill_stellar_contract_upload", "label": "stellar contract upload", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Build, deploy, invoke", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uploads WASM without instantiating, for factories or upgrades. stellar contract install is a deprecated alias."}, {"id": "claude_skills_smart_contracts_skill_mock_all_auths", "label": "mock_all_auths", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Minimal test", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_smart_contracts_skill_assets_skill", "label": "Assets Skill", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asset issuance, trustlines, and SAC deployment are covered by the assets skill."}, {"id": "claude_skills_smart_contracts_skill_dapp_skill", "label": "dApp Skill", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontends and wallets that call a contract are covered by the dapp skill."}, {"id": "claude_skills_smart_contracts_skill_data_skill", "label": "Data Skill", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chain data queries over RPC and Horizon are covered by the data skill."}, {"id": "claude_skills_smart_contracts_skill_zk_proofs_skill", "label": "ZK Proofs Skill", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ZK verification (BLS12-381, Groth16, Circom, Noir, RISC Zero) is covered by the zk-proofs skill."}, {"id": "claude_skills_smart_contracts_skill_standards_skill", "label": "Standards Skill", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEP and CAP standards and ecosystem links are covered by the standards skill."}, {"id": "claude_skills_smart_contracts_skill_soroban_examples", "label": "soroban-examples", "file_type": "concept", "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Documentation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official example contracts, including a liquidity pool, atomic swap, timelock, and single-offer."}], "edges": [{"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_development_development_patterns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "weight": 1.0}, {"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_testing_testing_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "weight": 1.0}, {"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_security_security_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "weight": 1.0}, {"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_skill_soroban", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "weight": 1.0}, {"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_skill_assets_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "weight": 1.0}, {"source": "claude_skills_smart_contracts_skill_stellar_smart_contracts", "target": "claude_skills_smart_contracts_skill