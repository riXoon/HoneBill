{"nodes": [{"id": "apps_legacy_backend_public_assets_banner_phones", "label": "Pijin three-phone marketing banner", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/banner/phones.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three silver smartphones with a top notch, arranged on black. The left phone is a dark welcome screen, the center phone is a light offline wallet, and the right phone is a dark screen with a thumbs-up pigeon and coins. The right phone is partly hidden, so its heading is cropped."}, {"id": "apps_legacy_backend_public_assets_banner_phones_welcome_screen", "label": "Welcome to Pijin screen", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/phones.png", "source_location": "left phone", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark navy screen. Heading reads Welcome to Pijin! Subtitle reads Universal Web3 Liquidity, Powered by Cellular. A gray pigeon in a navy cap holds a phone showing a yellow envelope, with a chat bubble beside it. Buttons read Create an account and Sign In. Four page dots sit at the bottom."}, {"id": "apps_legacy_backend_public_assets_banner_phones_offline_home", "label": "Offline wallet home", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/phones.png", "source_location": "center phone", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light screen headed by a shield, Short Id: j5jEbp, and a red dot with You are Offline. An Offline pill shows an unplugged plug and a pigeon head. The card reads Offline Balance and \u20b185.00, with a Syncing pill."}, {"id": "apps_legacy_backend_public_assets_banner_phones_enter_screen", "label": "Enter Pijin screen", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/phones.png", "source_location": "right phon