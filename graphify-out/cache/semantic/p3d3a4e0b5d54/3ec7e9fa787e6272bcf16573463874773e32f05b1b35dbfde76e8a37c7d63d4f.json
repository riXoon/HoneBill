e_location": "Time and ledger state", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_test_snapshots", "target": "claude_skills_smart_contracts_testing_event_assertions", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Snapshots, fork tests, mutation tests", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_mutation_tests", "target": "claude_skills_smart_contracts_testing_unit_tests", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Snapshots, fork tests, mutation tests", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_resource_profiling", "target": "claude_skills_smart_contracts_development_resource_limits", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Resource profiling", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_resource_profiling", "target": "claude_skills_smart_contracts_testing_resource_limits_in_tests", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Resource profiling", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_ci", "target": "claude_skills_smart_contracts_testing_unit_tests", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "CI", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_ci", "target": "claude_skills_smart_contracts_testing_stellar_quickstart", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "CI", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_ci", "target": "claude_skills_smart_contracts_skill_wasm32v1_none", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "CI", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_ci", "target": "claude_skills_smart_contracts_skill_stellar_cli", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "CI", "weight": 1.0}], "hyperedges": [{"id": "claude_skills_smart_contracts_testing_testing_layers", "label": "Testing Layers", "nodes": ["claude_skills_smart_contracts_testing_unit_tests", "claude_skills_smart_contracts_testing_stellar_quickstart", "claude_skills_smart_contracts_testing_testnet", "claude_skills_smart_contracts_testing_fork_tests"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Testing"}]}