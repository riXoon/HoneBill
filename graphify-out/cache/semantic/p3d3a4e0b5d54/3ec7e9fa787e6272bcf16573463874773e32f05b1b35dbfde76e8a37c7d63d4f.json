eight": 1.0}, {"source": "claude_skills_smart_contracts_testing_event_assertions", "target": "claude_skills_smart_contracts_development_contractevent", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Events", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_storage_ttl_tests", "target": "claude_skills_smart_contracts_development_persistent_storage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Storage TTL", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_storage_ttl_tests", "target": "claude_skills_smart_contracts_development_extend_ttl", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Storage TTL", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_cross_contract_tests", "target": "claude_skills_smart_contracts_development_contractimport", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Cross-contract", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_integration_tests", "target": "claude_skills_smart_contracts_testing_stellar_quickstart", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Integration tests", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_integration_tests", "target": "claude_skills_smart_contracts_testing_testnet", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Integration tests", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_integration_tests", "target": "claude_skills_smart_contracts_testing_stellar_sdk", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Integration tests", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_testnet", "target": "claude_skills_smart_contracts_testing_friendbot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Testnet", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_testnet", "target": "claude_skills_smart_contracts_skill_protocol_27", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Testnet", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_fuzzing", "target": "claude_skills_smart_contracts_testing_soroban_arbitrary", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Fuzz testing", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_fuzzing", "target": "claude_skills_smart_contracts_testing_soroban_token_fuzzer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Fuzz testing", "weight": 1.0}, {"source": "claude_skills_smart_contracts_testing_fuzzing", "target": "claude_skills_smart_contracts_testing_mock_auths", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/smart-contracts/testing.md", "source_location": "Fuzz t