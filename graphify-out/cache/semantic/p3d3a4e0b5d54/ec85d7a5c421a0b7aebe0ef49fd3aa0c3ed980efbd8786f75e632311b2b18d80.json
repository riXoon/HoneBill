{"nodes": [{"id": "docs_backend_rebuild_01_nestjs_migration_plan", "label": "Backend Rebuild: Next.js \u2192 NestJS", "file_type": "document", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_nestjs", "label": "NestJS", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native talks plain HTTP/JSON, so any backend works. NestJS is chosen for modules, dependency injection, guards, pipes, first-class queues, and Swagger on a long-running server."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_nextjs", "label": "Next.js", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_apps_backend", "label": "apps/backend", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New NestJS app, npm workspace name backend. It replaces the Next.js API while the legacy tree stays read-only."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_legacy_backend", "label": "apps/_legacy/backend", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_pijin_api", "label": "pijin-api.vercel.app", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Phase 8: Deploy and cutover", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy production stays live until Phase 8 cutover. Rollback points the mobile app back at this Vercel deploy and keeps it up until the Nest host is stable."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_prisma", "label": "Prisma", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_bullmq", "label": "BullMQ", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nest queues and processors run on Redis and replace QStash callbacks for SMS and settlement."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_ioredis", "label": "ioredis", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TCP Redis client for locks and throttler storage, replacing the legacy Upstash REST client while keeping the same lock TTL and semantics."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_qstash", "label": "Upstash QStash", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy queue for SMS callbacks and settlement. Decommission it with Vercel after a stable Nest cutover. The engine settlement worker exposes no QStash HTTP callback."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_upstash_redis", "label": "@upstash/redis", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_pijin_core", "label": "pijin_core", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_stellar_module", "label": "StellarModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps @stellar/stellar-sdk, Horizon and Soroban RPC clients, and the pijin_core contract client. After the Phase 4 cleanup it provides StellarService only."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_textbee", "label": "TextBee", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "SMS and offline vouchers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SMS gateway for OTP and inbound vouchers, with a primary device and a fallback device. The free plan allows only one active device, so fallback delivery is still unverified."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_docker", "label": "Docker", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host the API as a long-running Node 22 process in Docker on Railway, Render, Fly, or a VPS, not as a Vercel serverless app, so workers and in-process schedules can run."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_nodejs", "label": "Node.js 22", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_mobile", "label": "apps/mobile", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The legacy mobile client under apps/mobile/src/_legacy/services/api must keep working against Nest without changes. Cutover updates EXPO_PUBLIC_API_BASE_URL, EXPO_PUBLIC_ANCHOR_DOMAIN, and apps/mobile/eas.json."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_api_contract_parity", "label": "API contract parity", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep methods, JSON, status codes, and error shape the same after the global prefix so the mobile client works unchanged. Any intentional break is recorded in the Decision log first."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_legacy_readonly", "label": "Legacy read-only boundary", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read apps/_legacy/backend for reference and copy logic into Nest. Never import across the boundary and never edit the legacy app."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_same_database", "label": "Same database during migration", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copy prisma/schema.prisma and prisma/migrations as-is. No schema changes during the migration; new migrations only after cutover."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_port_tests", "label": "Port tests with the code", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Ground rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module is not done until its legacy tests are ported and passing. Unit tests move from node:test to Jest and keep fast-check property tests."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_api_v2_prefix", "label": "/api/v2 global prefix", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 2026-11-06 the Nest global prefix changed from /api to /api/v2 so the new API can run beside the legacy /api service. Paths, methods, JSON, and status codes after the prefix stay the same. Mobile clients add /v2 when pointed at Nest. /.well-known stays outside the prefix."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_method_parity", "label": "Route-specific error and method parity", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use 405 when the legacy route exports another method, and compare unknown paths by status only because Next.js and Nest format 404 bodies differently. Keep route-specific 401 text and the error field, because a global error normalizer would break the mobile client."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sep10_memo", "label": "SEP-10 memo preservation", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignore the GET memo parameter, but keep a memo claim when a valid POST challenge includes one. Legacy passes the GET memo where the Stellar SDK ignores it, while POST extracts and conditionally emits the challenge memo. Issuer validation stays aligned with the first SEP10_HOME_DOMAINS entry and sub must be a non-empty string."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_public_settlement_routes", "label": "Public transfer confirmation and settlement", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy confirm and settlement routes have no SEP-10 guard. Confirm only advances a stored transfer after Soroban RPC success. Settlement requires a valid sender Ed25519 voucher and a configured relayer. Adding session auth would break parity without adding transaction authorization."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sep10", "label": "SEP-10", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Auth, OTP, accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sep1", "label": "SEP-1", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Anchor (SEP-1, SEP-24)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sep24", "label": "SEP-24", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Anchor (SEP-1, SEP-24)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_phpc", "label": "PHPC", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Wallet, transactions, settlements", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_stellar_sdk", "label": "@stellar/stellar-sdk", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_auth_module", "label": "AuthModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Auth, OTP, accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/auth issues the SEP-10 challenge and POST /api/auth issues the JWT used by Sep10JwtGuard. PIN verify keeps the legacy Redis keys and the per-phone failure lock."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_otp_module", "label": "OtpModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Auth, OTP, accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Send and verify OTP, including OTP_TEST_MODE and test numbers. Verify issues an OTP verification JWT. The live OTP flow stayed blocked when test-mode confirmation and probe variables were absent."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_accounts_module", "label": "AccountsModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Auth, OTP, accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Register, users check, and users lookup. Register can require the OTP token when REQUIRE_OTP_TOKEN is set."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_wallet_module", "label": "WalletModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Wallet, transactions, settlements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balance reads Horizon PHPC and USDC trustlines and falls back to zero. History reconciles settlements, anchors, and online transfers. Transfer confirm is a public Soroban RPC check that returns 409 or 422."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_settlements_module", "label": "SettlementsModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Wallet, transactions, settlements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/settlements verifies an offline voucher Ed25519 signature and submits it through the relayer."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_engine_module", "label": "EngineModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Engine (Soroban contract)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soroban deposit, withdraw, online transfer, offline-key rotation, and recipient registry. Online transfer requires protocol v2. Settle runs as a BullMQ processor instead of a public QStash callback. Live testnet verification of every engine route is still pending."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sms_module", "label": "SmsModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "SMS and offline vouchers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_anchor_module", "label": "AnchorModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Phase 6: Anchor (SEP-1 / SEP-24)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves SEP-1 stellar.toml at the domain root and the SEP-24 anchor API under the global prefix. Interactive deposit and withdraw URLs are signed as separate 15-minute HS256 JWTs. Simulate-payment is testnet-only and uses a one-time Redis claim. Phase 6 is not ready to ship until the deferred web pages and remaining live database-backed parity checks are done."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_health_module", "label": "HealthModule", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Change log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminus checks database, Redis, and RPC at /api/health, but the response keeps the legacy health envelope and degraded status. A live check showed an unrebuilt Nest process returning HTTP 503 while legacy returned HTTP 200 with that envelope."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sep10_jwt_guard", "label": "Sep10JwtGuard", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Auth, OTP, accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_ed25519_signature_guard", "label": "Ed25519SignatureGuard", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Engine (Soroban contract)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies canonical deposit, withdraw, and versioned online-transfer messages with strict Base64 signatures."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_textbee_signature_guard", "label": "TextbeeSignatureGuard", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Phase 5: SMS and queues", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /api/sms/webhook reads a bounded raw body and checks TextBee HMAC-SHA256 with TEXTBEE_WEBHOOK_SECRET from x-signature or x-textbee-signature before parsing the voucher."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_engine_settlement", "label": "engine-settlement queue", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Phase 5: SMS and queues", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SMS and engine share SettlementQueueService, queue engine-settlement, and job process-offline-voucher. Nonce-cache markers are written only after a successful publish. Jobs already buffered in the obsolete pijin-settlements queue are not migrated automatically."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_retry_classifier", "label": "Settlement retry classifier", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Phase 5: SMS and queues", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The producer keeps five attempts with exponential backoff, and permanent worker errors stay unrecoverable. Phase 4 ports engine-retry-classifier.test.ts. A hosted Redis probe completed an isolated BullMQ job, but the app engine-settlement worker and its retry schedule were not exercised. BullMQ warned that the Redis eviction policy is volatile-* and noeviction is preferred."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_sms_dispatch_secret", "label": "SMS_DISPATCH_SECRET", "file_type": "concept", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Decision log", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QStash signatures go away with the queue migration. The header x-sms-dispatch-secret protects POST /api/sms/dispatch while callers still use HTTP, and the route stays unavailable when the secret is unset. BullMQ delivery is the preferred internal path."}, {"id": "docs_backend_rebuild_01_nestjs_migration_plan_deferred_web_pages", "label": "Deferred web pages", "file_type": "rationale", "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Deferred \u23f8: web pages", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEP-24 deposit and withdraw pages are required before Phase 6 can ship. Privacy policy and delete-account pages are likely required by app stores. Whether Nest server-rendered views or a separate small web app serves them is undecided."}], "edges": [{"source": "docs_backend_rebuild_01_nestjs_migration_plan_apps_backend", "target": "docs_backend_rebuild_01_nestjs_migration_plan_nestjs", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_backend_rebuild_01_nestjs_migration_plan_legacy_backend", "target": "docs_backend_rebuild_01_nestjs_migration_plan_nextjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend-rebuild/01-nestjs-migration-plan.md", "source_location": "Target architecture", "weight": 1.0}, {"source": "docs_backend_rebuild_01_nestjs_migration_plan_legacy_readonly", "target": "docs_backend_rebuild_01_nestjs_migration_plan_legacy_backend", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1