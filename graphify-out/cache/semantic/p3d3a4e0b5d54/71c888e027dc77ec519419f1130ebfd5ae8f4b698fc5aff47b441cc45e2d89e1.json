{"nodes": [{"id": "apps_legacy_backend_public_assets_banner_ring", "label": "Oblique white ring line drawing", "file_type": "image", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Square 2159\u00d72159 RGBA picture. The field is fully transparent; the only opaque pixels are thin white strokes. Three elliptical outlines of almost the same size cross near the upper-left and lower-right and run as parallel arcs along the top and bottom. No text, fill, gradient, or second color. A dark preview shows black only because the background is empty."}, {"id": "apps_legacy_backend_public_assets_banner_ring_offset_ellipses", "label": "Three offset elliptical strokes", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three unfilled hairline ellipses, nearly equal in size, sit on the same center and are rotated a few degrees apart. They stay close and parallel on the long arcs."}, {"id": "apps_legacy_backend_public_assets_banner_ring_limb_crossings", "label": "Upper-left and lower-right limb crossings", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The three strokes meet and cross at two opposite limbs, upper-left and lower-right, then separate again. Those crossings are drawn, not implied."}, {"id": "apps_legacy_backend_public_assets_banner_ring_transparent_canvas", "label": "Transparent square canvas", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RGBA color type. Corner and center samples are alpha 0. Opaque pixels are near-white only and sit in a centered band inset about 276 pixels from each edge of the 2159-pixel square."}, {"id": "apps_legacy_backend_public_assets_banner_ring_inclined_band", "label": "Inclined circular band", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equal ellipses that cross at two limbs and run parallel between them are how a thick circular ring looks when the ring plane is tilted. The drawing does not label that reading."}, {"id": "apps_legacy_backend_public_assets_banner_ring_torus_contour", "label": "Torus contour reading", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tube-shaped ring can project as a few nested elliptical contours. This picture has only three strokes and no meridians, so the torus reading is a likeness of the same outline, not a labeled diagram."}, {"id": "apps_legacy_backend_public_assets_banner_ring_banner_ornament", "label": "Banner ornament", "file_type": "concept", "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The asset sits in public/assets/banner. It is a centered mark with no lettering and a transparent ground, so it can overlay a banner rather than explain a chart or screenshot."}], "edges": [{"source": "apps_legacy_backend_public_assets_banner_ring", "target": "apps_legacy_backend_public_assets_banner_ring_offset_ellipses", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring", "target": "apps_legacy_backend_public_assets_banner_ring_limb_crossings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring", "target": "apps_legacy_backend_public_assets_banner_ring_transparent_canvas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring_offset_ellipses", "target": "apps_legacy_backend_public_assets_banner_ring_limb_crossings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring_offset_ellipses", "target": "apps_legacy_backend_public_assets_banner_ring_inclined_band", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring_limb_crossings", "target": "apps_legacy_backend_public_assets_banner_ring_inclined_band", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/_legacy/backend/public/assets/banner/ring.png", "source_location": null, "weight": 1.0}, {"source": "apps_legacy_backend_public_assets_banner_ring_inclined_band", "target": "apps_legacy_backend_public_assets_banner_ring_torus_contour", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/_legacy/backend/public/assets/banner/r