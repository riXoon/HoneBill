{"nodes": [{"id": "claude_skills_react_native_dev_references_architecture_document", "label": "React Native Architecture Reference", "file_type": "document", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults for project structure, navigation, state, storage, native modules, offline behavior, errors, and accessibility when the repo has no convention yet."}, {"id": "claude_skills_react_native_dev_references_architecture_react_navigation", "label": "React Navigation", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type param lists such as RootStackParamList and use typed useNavigation and useRoute. Pass serializable ids, not whole objects. An auth gate should switch navigators rather than unmount providers, or state resets unexpectedly."}, {"id": "claude_skills_react_native_dev_references_architecture_native_stack", "label": "@react-navigation/native-stack", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer the native stack over a JS stack for performance and native transitions."}, {"id": "claude_skills_react_native_dev_references_architecture_react_freeze", "label": "react-freeze", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "freezeOnBlur with react-freeze stops expensive background screens from working while they are not focused. Lazy-load heavy tabs and screens."}, {"id": "claude_skills_react_native_dev_references_architecture_zustand", "label": "Zustand", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the small-store options for cross-screen client state, used with selectors."}, {"id": "claude_skills_react_native_dev_references_architecture_redux_toolkit", "label": "Redux Toolkit", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the small-store options for cross-screen client state, used with selectors."}, {"id": "claude_skills_react_native_dev_references_architecture_jotai", "label": "Jotai", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the small-store options for cross-screen client state, used with selectors."}, {"id": "claude_skills_react_native_dev_references_architecture_client_state", "label": "Cross-screen client state", "file_type": "rationale", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a small store such as Zustand, Redux Toolkit, Jotai, or the repo's existing store, with selectors. Normalize large collections by id, keep derived data in selectors, and do not copy server data into local state or put high-frequency values in global state."}, {"id": "claude_skills_react_native_dev_references_architecture_tanstack_query", "label": "TanStack Query", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server data belongs in a cache that dedupes, sets staleTime, retries, refetches in the background, and aborts on unmount. Do not mirror it into local state just in case."}, {"id": "claude_skills_react_native_dev_references_architecture_rxjs", "label": "RxJS", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use observables only when they are already in the repo, and always unsubscribe."}, {"id": "claude_skills_react_native_dev_references_architecture_expo_secure_store", "label": "expo-secure-store", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets, keys, seed phrases, and tokens belong here or in Keychain or Keystore. Values must stay small. Consider biometrics. Never log or persist secrets in plain storage."}, {"id": "claude_skills_react_native_dev_references_architecture_mmkv", "label": "MMKV", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast synchronous storage for small non-sensitive preferences. Prefer it over AsyncStorage when speed matters."}, {"id": "claude_skills_react_native_dev_references_architecture_async_storage", "label": "AsyncStorage", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async and slower than MMKV, with about a 6MB default cap on Android. Only for small non-sensitive preferences."}, {"id": "claude_skills_react_native_dev_references_architecture_expo_sqlite", "label": "expo-sqlite", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use SQLite for structured queryable data. Add indexes, paginate queries, and batch writes in transactions. Run migrations before the first query but off the first-paint path when possible."}, {"id": "claude_skills_react_native_dev_references_architecture_drizzle", "label": "Drizzle", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional ORM on expo-sqlite when the repo already uses Drizzle or another ORM."}, {"id": "claude_skills_react_native_dev_references_architecture_expo_file_system", "label": "expo-file-system", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep media in the file system and store paths in state, not blobs."}, {"id": "claude_skills_react_native_dev_references_architecture_netinfo", "label": "NetInfo", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Offline-first & resilience", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connectivity is only a hint. The truth is whether requests succeed. Retry idempotent calls with exponential backoff and jitter, and use idempotency keys for writes that retry. Queue actions locally and replay them on reconnect."}, {"id": "claude_skills_react_native_dev_references_architecture_sentry", "label": "Sentry", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Error boundaries miss async and event-handler errors, so register ErrorUtils.setGlobalHandler or a crash reporter such as Sentry. Scrub PII and secrets from logs."}, {"id": "claude_skills_react_native_dev_references_architecture_error_boundary", "label": "ErrorBoundary", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Put a recoverable fallback on a root boundary, and extra boundaries around risky widgets such as WebView, camera, and charts. User-facing errors should say what to do, not show a stack trace."}, {"id": "claude_skills_react_native_dev_references_architecture_keyboard_avoiding_view", "label": "KeyboardAvoidingView", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Accessibility & UX baseline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use KeyboardAvoidingView or a keyboard-controller consistently, and test forms with the keyboard open on small Android screens."}, {"id": "claude_skills_react_native_dev_references_architecture_back_handler", "label": "BackHandler", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handle the Android back button for modals and flows with unsaved state, using BackHandler and beforeRemove."}, {"id": "claude_skills_react_native_dev_references_architecture_react_native_get_random_values", "label": "react-native-get-random-values", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load Node polyfills first in index.ts. Random values must load before anything that calls crypto. Order matters."}, {"id": "claude_skills_react_native_dev_references_architecture_buffer", "label": "buffer", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The buffer package is one of the polyfills Node-oriented crypto and Stellar or Bitcoin SDKs need before they run."}, {"id": "claude_skills_react_native_dev_references_architecture_react_native_url_polyfill", "label": "react-native-url-polyfill", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URL polyfill for Node-oriented libraries. Load it with the other polyfills at the start of index.ts."}, {"id": "claude_skills_react_native_dev_references_architecture_fast_text_encoding", "label": "fast-text-encoding", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TextEncoder polyfill for Node-oriented libraries. Keep the polyfill set minimal and ordered."}, {"id": "claude_skills_react_native_dev_references_architecture_app_state", "label": "AppState", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Offline-first & resilience", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On background, pause polling. On foreground, refresh. Signing, submitting a transaction, and uploads must be resumable and de-duplicated so a killed app cannot double-submit."}, {"id": "claude_skills_react_native_dev_references_architecture_stellar_sdk", "label": "Stellar SDK", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stellar SDKs are Node-oriented and need crypto, buffer, URL, and TextEncoder polyfills loaded before they run. Expose that work through one service wrapper so a faster native implementation can replace it later."}, {"id": "claude_skills_react_native_dev_references_architecture_bitcoin_sdk", "label": "Bitcoin SDK", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bitcoin SDKs are grouped with Stellar SDKs as Node-oriented libraries that need the same polyfills, with random values loaded first."}, {"id": "claude_skills_react_native_dev_references_architecture_new_architecture", "label": "New Architecture", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer Expo SDK modules and maintained libraries over custom native code, and check New Architecture support. Native code needs a dev-client or EAS rebuild, not a Metro reload."}, {"id": "claude_skills_react_native_dev_references_architecture_eas", "label": "EAS", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything with native code needs an EAS or dev-client rebuild. Tell the user a Metro reload will not pick it up."}, {"id": "claude_skills_react_native_dev_references_architecture_expo", "label": "Expo SDK", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Native modules, polyfills, config plugins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer Expo modules. In managed or CNG projects, use config plugins instead of hand-editing the android and ios directories. Stub Node built-ins in Metro with resolver.extraNodeModules or resolveRequest rather than patching libraries."}, {"id": "claude_skills_react_native_dev_references_architecture_webview", "label": "WebView", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WebView is a risky widget that should sit inside its own error boundary."}, {"id": "claude_skills_react_native_dev_references_architecture_camera", "label": "Camera", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera is a risky widget that should sit inside its own error boundary."}, {"id": "claude_skills_react_native_dev_references_architecture_charts", "label": "Charts", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Error handling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Charts are a risky widget that should sit inside their own error boundary."}], "edges": [{"source": "claude_skills_react_native_dev_references_architecture_react_navigation", "target": "claude_skills_react_native_dev_references_architecture_native_stack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_react_navigation", "target": "claude_skills_react_native_dev_references_architecture_react_freeze", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_react_navigation", "target": "claude_skills_react_native_dev_references_architecture_back_handler", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Navigation (React Navigation)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_zustand", "target": "claude_skills_react_native_dev_references_architecture_client_state", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_redux_toolkit", "target": "claude_skills_react_native_dev_references_architecture_client_state", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_jotai", "target": "claude_skills_react_native_dev_references_architecture_client_state", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_tanstack_query", "target": "claude_skills_react_native_dev_references_architecture_client_state", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_rxjs", "target": "claude_skills_react_native_dev_references_architecture_client_state", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "State & data", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_mmkv", "target": "claude_skills_react_native_dev_references_architecture_async_storage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/architecture.md", "source_location": "Storage choices", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_architecture_expo_sqlite", "target": "claude_skills_react_native_dev_references_architectu