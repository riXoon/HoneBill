ase-and-platform.md", "source_location": "Pre-release checklist", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_elevation", "target": "claude_skills_react_native_dev_references_performance_ui_thread", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Android vs iOS quirks to check", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_react_native_testing_library", "target": "claude_skills_react_native_dev_references_architecture_netinfo", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_react_native_testing_library", "target": "claude_skills_react_native_dev_references_architecture_expo_secure_store", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_react_native_testing_library", "target": "claude_skills_react_native_dev_references_architecture_camera", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}], "hyperedges": []}