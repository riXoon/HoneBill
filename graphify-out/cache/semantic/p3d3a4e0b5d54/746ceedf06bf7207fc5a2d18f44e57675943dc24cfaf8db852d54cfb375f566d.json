{"nodes": [{"id": "claude_skills_react_native_dev_references_release_and_platform_document", "label": "Release, Testing and Platform Reference", "file_type": "document", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers the Expo dev-client workflow, release-build checks, test layers, Android versus iOS quirks, crash and ANR triage, and the pre-release checklist."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_expo", "label": "Expo", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JS-only changes reload in Metro. Native dependency or config-plugin changes need expo run:android, expo run:ios, or an EAS development build."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_eas", "label": "EAS", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep development (dev client), preview (internal, release-like), and production profiles in eas.json. Judge speed on preview, not on a dev bundle. Dev mode lies about performance."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_dev_client", "label": "Dev client", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new native module or config plugin requires a new dev client. A Metro reload only picks up JavaScript."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_metro", "label": "Metro", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JS-only changes reload through Metro. A USB Android device reaches it with adb reverse tcp:8081 tcp:8081. Phantom errors from a stale cache can be cleared with expo start -c, but fix the root cause rather than clearing the cache by habit."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_expo_doctor", "label": "expo-doctor", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npx expo-doctor and npx expo install --check catch SDK and library mismatches after upgrades. A launch crash after a package update is often a native and JS version mismatch that a rebuild plus expo-doctor will show."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_hermes", "label": "Hermes", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Verifying a release-like build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before trusting a speed number, confirm Hermes and minification are on, dev warnings are off, and console calls are stripped. Compare at least three runs on the same device and discard the first. A release-only crash can also be Hermes-unsupported syntax."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_jest", "label": "Jest", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit-test pure logic, services, and hooks: parsing, formatting, retry and queue logic, reducers, and crypto wrappers. Use fake timers for backoff. Test interleavings such as double-submit and reconnect mid-request."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_react_native_testing_library", "label": "React Native Testing Library", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assert user-visible behavior, not implementation details. renderHook from React Native Testing Library or testing-library/react-hooks covers hooks. Mock native modules at the boundary: secure store, NetInfo, and camera."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_maestro", "label": "Maestro", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flow tests cover login and onboarding, the money-critical path, and offline to online recovery. Detox is the named alternative."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_detox", "label": "Detox", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detox is the alternative to Maestro for the same end-to-end flows, including offline recovery."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_flashlight", "label": "Flashlight", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flashlight, or a manual performance budget, checks startup time and list FPS on a reference device."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_sentry", "label": "Sentry", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Crash / ANR triage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship Sentry or Crashlytics with source maps and symbol upload so release traces are readable. JS red boxes only cover JS errors."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_crashlytics", "label": "Crashlytics", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Crash / ANR triage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crashlytics is the named alternative to Sentry for symbolicated release crashes."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_r8_proguard", "label": "R8/ProGuard", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Crash / ANR triage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crash that appears only in release can be minification stripping needed code. Add keep rules. The pre-release checklist also requires R8 shrinking and an AAB size review."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_gradle", "label": "Gradle", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For Android native weirdness, clean with gradlew clean from the android directory after finding the root cause."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_adb", "label": "adb", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "adb reverse exposes Metro on a USB device. adb logcat filtered to AndroidRuntime, ReactNativeJS, and libhermes is the native crash trace. ANR thread dumps come from Play Console or adb bugreport."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_anr", "label": "ANR", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Crash / ANR triage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Look for synchronous native I/O or heavy work on the main thread. Device-only crashes can also be low memory, OEM task killers, a missing 32-bit ABI, or minSdkVersion."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_keyboard_avoiding_view", "label": "KeyboardAvoidingView", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Android vs iOS quirks to check", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On iOS use KeyboardAvoidingView behavior padding. On Android, windowSoftInputMode resize behavior can cover inputs."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_wkwebview", "label": "WKWebView", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Android vs iOS quirks to check", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS WebView follows WKWebView intelligent tracking prevention and cookie rules. Android WebView needs explicit file-access and mixed-content settings."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_ota", "label": "OTA rollback", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Pre-release checklist", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Have an OTA channel or the previous build ready to roll back. Bump versionCode and buildNumber, and match store privacy answers to the SDKs actually used."}, {"id": "claude_skills_react_native_dev_references_release_and_platform_elevation", "label": "elevation", "file_type": "concept", "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Android vs iOS quirks to check", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android shadows are elevation only, with no colored shadows before API 28. iOS uses the shadow props. Edge-to-edge is enforced on Android SDK 35 and newer."}], "edges": [{"source": "claude_skills_react_native_dev_references_release_and_platform_dev_client", "target": "claude_skills_react_native_dev_references_release_and_platform_eas", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_dev_client", "target": "claude_skills_react_native_dev_references_release_and_platform_metro", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_expo", "target": "claude_skills_react_native_dev_references_release_and_platform_dev_client", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_expo_doctor", "target": "claude_skills_react_native_dev_references_release_and_platform_expo", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_gradle", "target": "claude_skills_react_native_dev_references_release_and_platform_dev_client", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_adb", "target": "claude_skills_react_native_dev_references_release_and_platform_metro", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Dev workflow (Expo)", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_hermes", "target": "claude_skills_react_native_dev_references_release_and_platform_eas", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Verifying a release-like build", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_jest", "target": "claude_skills_react_native_dev_references_release_and_platform_react_native_testing_library", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_maestro", "target": "claude_skills_react_native_dev_references_release_and_platform_detox", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_flashlight", "target": "claude_skills_react_native_dev_references_performance_startup", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Testing strategy", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_sentry", "target": "claude_skills_react_native_dev_references_release_and_platform_crashlytics", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/references/release-and-platform.md", "source_location": "Crash / ANR triage", "weight": 1.0}, {"source": "claude_skills_react_native_dev_references_release_and_platform_sentry", "target": "claude_skills_react_native_dev_references_release_and_platform_anr", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/react-native-dev/referen