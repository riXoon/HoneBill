{"nodes": [{"id": "docs_deliverable_2_security_summary", "label": "Deliverable 2: Security Hardening & Webhook/QStash Pipeline", "file_type": "document", "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secure the Vercel coordinator ingestion and settlement pipeline. Before this work, webhooks and relayer workers were exposed to payload spoofing, unbounded-stream denial of service, replay, duplicate customer alerts, and silent failures on unmapped accounts or contract errors. Status is completed, with 55 of 55 tests passing under tsx --test."}, {"id": "docs_deliverable_2_security_summary_pijin_relayer", "label": "Pijin Relayer", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project OmniFi / Pijin Relayer. Deliverable 2 is the Vercel Coordinator Backend, Phase 1."}, {"id": "docs_deliverable_2_security_summary_janrellll", "label": "JANRELLLL", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigned engineer for Deliverable 2."}, {"id": "docs_deliverable_2_security_summary_markkkkk", "label": "MARKKKKK", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigned engineer for Deliverable 2."}, {"id": "docs_deliverable_2_security_summary_textbee", "label": "Textbee", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "1. Executive Summary & Goal Mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deliverable_2_security_summary_qstash", "label": "Upstash QStash", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "1. Executive Summary & Goal Mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serverless queue between the SMS webhook and the settlement worker. Retryable handler responses are retried by QStash; permanent failures return HTTP 200 so the retry loop stops."}, {"id": "docs_deliverable_2_security_summary_soroban", "label": "Soroban", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "1. Executive Summary & Goal Mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stellar Soroban contract calls are the expensive end of the pipeline. Malformed input is rejected before RPC execution or transaction fees."}, {"id": "docs_deliverable_2_security_summary_textbee_webhook_secret", "label": "TEXTBEE_WEBHOOK_SECRET", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared HMAC secret. Verification fails closed in production when it is unset."}, {"id": "docs_deliverable_2_security_summary_verify_textbee_hmac", "label": "verifyTextbeeHmac", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constant-time HMAC-SHA256 using crypto.timingSafeEqual, so timing side channels do not leak the secret. Accepts a sha256= prefix, raw hex, and Base64 digests. Implemented in apps/backend/lib/sms-security.ts."}, {"id": "docs_deliverable_2_security_summary_read_bounded_request_body", "label": "readBoundedRequestBody", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the request stream once with a hard ceiling: 2048 bytes for webhooks and 65536 bytes for settlement. Rejects early from Content-Length and aborts if the stream exceeds the ceiling, so HMAC can use cached raw bytes without re-reading the body."}, {"id": "docs_deliverable_2_security_summary_verify_timestamp_drift", "label": "verifyTimestampDrift", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks x-timestamp or x-textbee-timestamp inside a plus or minus 300 second window. Accepts 10-digit seconds and 13-digit milliseconds. Passes when the header is absent, and enforces drift when it is present."}, {"id": "docs_deliverable_2_security_summary_verify_qstash_signature", "label": "verifyQStashSignature", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps the Upstash QStash Receiver over the pre-read raw body. A missing or invalid signature returns valid false instead of throwing HTTP 500, so the route can respond 401 or 403."}, {"id": "docs_deliverable_2_security_summary_is_retryable_settlement_error", "label": "isRetryableSettlementError", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retryable faults return true and HTTP 500 so QStash retries: HTTP 429, 502, 503, 504, network drops, and Stellar tx_bad_seq or tx_insufficient_fee. Permanent faults return false and HTTP 200 with status FAILED: Soroban contract errors, invalid Ed25519 signatures, account or token misses, and corrupted vouchers. That stops the retry loop."}, {"id": "docs_deliverable_2_security_summary_normalize_settlement_user_failure", "label": "normalizeSettlementUserFailure", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operator logs keep a sanitized root cause on Settlement.failReason. User SMS gets short copy such as insufficient balance or an already-used voucher, without contract codes or stack traces. A raw internal stack trace yields an empty string so a safe fallback is used. sendSms failures are caught so a telecom error cannot change the QStash status code."}, {"id": "docs_deliverable_2_security_summary_parse_offline_voucher", "label": "parseOfflineVoucher", "file_type": "rationale", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.3 `apps/backend/lib/offline-voucher.ts` \u2014 Cryptographic Voucher Validation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-trust parse of tokenId:senderShortId:receiverShortId:amountBase62:nonce:signature. Requires exactly six parts, 6-character Base62 short ids, a 32-byte nonce, a 64-byte Ed25519 signature, a positive amount, and an amount no higher than the Soroban i128 maximum."}, {"id": "docs_deliverable_2_security_summary_sms_webhook", "label": "/api/sms/webhook", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.1 `/api/sms/webhook/route.ts` (Ingress Gateway)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ingress gateway. Authenticates Textbee before business logic, drops MESSAGE_SENT delivery receipts, caps SMS at 300 characters, allows 3 requests per 60 seconds per sender phone, and fail-opens a 24-hour Redis nonce check. The eager processing SMS was removed so QStash would not double-text the user. Preview deployments resolve the settlement URL from the Host header, falling back to NEXT_PUBLIC_APP_URL."}, {"id": "docs_deliverable_2_security_summary_engine_settle", "label": "/api/engine/settle", "file_type": "concept", "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.2 `/api/engine/settle/route.ts` (QStash Settlement Worker)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QStash settlement worker with a 64 KB body ceiling and an upstash-signature check. A Prisma unique nonce returns DUPLICATE_SKIPPED for a completed settlement. A local Ed25519 check against the registered offline device key aborts bad vouchers before relayer fees. Non-retryable failures notify the sender by SMS."}], "edges": [{"source": "docs_deliverable_2_security_summary", "target": "docs_deliverable_2_security_summary_pijin_relayer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "weight": 1.0}, {"source": "docs_deliverable_2_security_summary", "target": "docs_deliverable_2_security_summary_janrellll", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "weight": 1.0}, {"source": "docs_deliverable_2_security_summary", "target": "docs_deliverable_2_security_summary_markkkkk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": null, "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_textbee_hmac", "target": "docs_deliverable_2_security_summary_sms_webhook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.1 `/api/sms/webhook/route.ts` (Ingress Gateway)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_textbee_hmac", "target": "docs_deliverable_2_security_summary_textbee_webhook_secret", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_textbee_hmac", "target": "docs_deliverable_2_security_summary_textbee", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.1 `apps/backend/lib/sms-security.ts` \u2014 Ingress Security Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_read_bounded_request_body", "target": "docs_deliverable_2_security_summary_sms_webhook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.1 `/api/sms/webhook/route.ts` (Ingress Gateway)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_read_bounded_request_body", "target": "docs_deliverable_2_security_summary_engine_settle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.2 `/api/engine/settle/route.ts` (QStash Settlement Worker)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_timestamp_drift", "target": "docs_deliverable_2_security_summary_sms_webhook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.1 `/api/sms/webhook/route.ts` (Ingress Gateway)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_qstash_signature", "target": "docs_deliverable_2_security_summary_engine_settle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.2 `/api/engine/settle/route.ts` (QStash Settlement Worker)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_verify_qstash_signature", "target": "docs_deliverable_2_security_summary_qstash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_is_retryable_settlement_error", "target": "docs_deliverable_2_security_summary_engine_settle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_is_retryable_settlement_error", "target": "docs_deliverable_2_security_summary_qstash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_normalize_settlement_user_failure", "target": "docs_deliverable_2_security_summary_engine_settle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.2 `apps/backend/lib/qstash-security.ts` \u2014 Queue & Fault Isolation Layer", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_parse_offline_voucher", "target": "docs_deliverable_2_security_summary_soroban", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "2.3 `apps/backend/lib/offline-voucher.ts` \u2014 Cryptographic Voucher Validation", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_parse_offline_voucher", "target": "docs_deliverable_2_security_summary_engine_settle", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.2 `/api/engine/settle/route.ts` (QStash Settlement Worker)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_sms_webhook", "target": "docs_deliverable_2_security_summary_textbee", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.1 `/api/sms/webhook/route.ts` (Ingress Gateway)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_engine_settle", "target": "docs_deliverable_2_security_summary_qstash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "3.2 `/api/engine/settle/route.ts` (QStash Settlement Worker)", "weight": 1.0}, {"source": "docs_deliverable_2_security_summary_engine_settle", "target": "docs_deliverable_2_security_summary_soroban", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "5. Conclusion & Operational Impact", "weight": 1.0}], "hyperedges": [{"id": "docs_deliverable_2_security_summary_ingestion_pipeline", "label": "SMS ingestion and settlement pipeline", "relation": "participate_in", "nodes": ["docs_deliverable_2_security_summary_textbee", "docs_deliverable_2_security_summary_qstash", "docs_deliverable_2_security_summary_soroban"], "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deliverable-2-security-summary.md", "source_location": "1. Executive Summary & Goal Mapping", "weight": 1.0}]}