{"nodes": [{"id": "agents_skills_smart_contracts_skill", "label": "Stellar Smart Contracts", "file_type": "document", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_soroban", "label": "Soroban", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Stellar Smart Contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smart contracts on Stellar were formerly branded Soroban. The platform name is retired, but the Rust SDK (soroban-sdk) and several tool names keep the prefix."}, {"id": "agents_skills_smart_contracts_skill_soroban_sdk", "label": "soroban-sdk", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The soroban-sdk major version tracks the protocol version. Pin the SDK major to the network you deploy to, because testnet upgrades by validator vote before mainnet. Pre-releases exist only during a protocol rollout and must be pinned with the exact version string."}, {"id": "agents_skills_smart_contracts_skill_protocol_27", "label": "Protocol 27", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This skill was written against protocol 27, which mainnet ran at the time of writing. Live protocol version comes from RPC getVersionInfo or Stellar Lab, not from a frozen doc."}, {"id": "agents_skills_smart_contracts_skill_rs_soroban_env", "label": "rs-soroban-env", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_stellar_cli", "label": "Stellar CLI", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Versions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stellar-cli v27 matches the protocol this skill was written against. Live network limits come from stellar network settings or Stellar Lab, because numeric limits change by validator vote."}, {"id": "agents_skills_smart_contracts_skill_no_std", "label": "no_std", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contracts must be #![no_std] and use soroban_sdk types such as String, Vec, Map, and Symbol, not the Rust standard library."}, {"id": "agents_skills_smart_contracts_skill_wasm32v1_none", "label": "wasm32v1-none", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wasm32v1-none is the only Wasm target the Stellar runtime supports, and it requires Rust 1.84 or newer."}, {"id": "agents_skills_smart_contracts_skill_env", "label": "Env", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything a contract can do hangs off Env. There is no I/O, no networking, and no clock beyond the ledger timestamp."}, {"id": "agents_skills_smart_contracts_skill_symbol", "label": "Symbol", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symbol is limited to 32 characters from a-z, A-Z, 0-9, and underscore. symbol_short! covers up to 9 characters."}, {"id": "agents_skills_smart_contracts_skill_storage", "label": "Storage", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storage is rented: every entry has a TTL and can be archived."}, {"id": "agents_skills_smart_contracts_skill_ttl", "label": "TTL", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_reentrancy", "label": "Cross-contract Reentrancy", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no delegatecall, and the host blocks cross-contract reentrancy."}, {"id": "agents_skills_smart_contracts_skill_wasm_size_limit", "label": "Contract WASM Size Limit", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Platform constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiled contracts are limited to 128KB. The limit is network-configured."}, {"id": "agents_skills_smart_contracts_skill_authorization", "label": "Authorization", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_require_auth", "label": "require_auth", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_constructor", "label": "__constructor", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "__constructor runs once, atomically, at deploy time, and does not run again on upgrade."}, {"id": "agents_skills_smart_contracts_skill_contractevent", "label": "contractevent", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#[topic] fields become event topics and the remaining fields go in the data payload."}, {"id": "agents_skills_smart_contracts_skill_contracterror", "label": "contracterror", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_instance_storage", "label": "Instance Storage", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_extend_ttl", "label": "extend_ttl", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Contract anatomy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "extend_ttl(threshold, extend_to) keeps instance state from being archived."}, {"id": "agents_skills_smart_contracts_skill_sep41", "label": "SEP-41", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_sac", "label": "Stellar Asset Contract", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_testutils", "label": "soroban-sdk testutils", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Project setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dev-dependency enables the testutils feature and must use the same SDK major as the contract dependency. The lib crate type is required for tests and fuzzing."}, {"id": "agents_skills_smart_contracts_skill_mock_all_auths", "label": "mock_all_auths", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Minimal test", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_contract_upload", "label": "stellar contract upload", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Build, deploy, invoke", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upload stores WASM without instantiating it, which factories and upgrades need. stellar contract install is a deprecated alias."}, {"id": "agents_skills_smart_contracts_skill_assets_skill", "label": "Assets Skill", "file_type": "concept", "source_file": ".agents/skills/smart-contracts/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_smart_contracts_skill_dapp_skill", "label": "dApp Skill", "file_type": "concept", "source_file": ".agents/