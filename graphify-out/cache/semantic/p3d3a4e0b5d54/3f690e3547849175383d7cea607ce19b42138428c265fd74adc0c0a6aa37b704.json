{"nodes": [{"id": "claude_skills_assets_skill_document", "label": "Stellar Assets, Trustlines, and SAC", "file_type": "document", "source_file": ".claude/skills/assets/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_assets_skill_stellar_assets", "label": "Stellar Assets (Classic)", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Stellar Assets (Classic)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer classic Stellar assets over custom contract tokens unless custom logic is required. They are built in, cheaper than contract calls, and have wallet, exchange, and order-book DEX support, plus freeze and clawback for compliance."}, {"id": "claude_skills_assets_skill_trustlines", "label": "Trustlines", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Trustlines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A credit asset requires a trustline. ChangeTrust with limit 0 deletes one only when the balance is exactly 0, buying liabilities are cleared, and no liquidity pool still uses the asset. Claimable balances and wallet-display entries are not trustlines."}, {"id": "claude_skills_assets_skill_sac", "label": "Stellar Asset Contract", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Stellar Asset Contract (SAC)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAC is the smart-contract interface for an existing classic asset. Use it inside a contract or DeFi protocol. Royalties, fees, and transfer restrictions can often be a normal issued asset plus a thin SAC admin contract instead of a fully custom token."}, {"id": "claude_skills_assets_skill_sep_41", "label": "SEP-41", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SAC vs Custom Token Interface", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contract-token standard. The SAC interface is balance, transfer, approve, allowance, decimals, name, and symbol."}, {"id": "claude_skills_assets_skill_contract_tokens", "label": "Contract Tokens", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a custom SEP-41 contract only when the SAC cannot express the behavior: complex transfer logic, custom authorization, non-standard tokens, custom DeFi integration, or NFTs and semi-fungible tokens. A fully custom token is a last resort."}, {"id": "claude_skills_assets_skill_xlm", "label": "XLM", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stellar's native currency. No trustline is required."}, {"id": "claude_skills_assets_skill_credit_asset", "label": "Credit Asset", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issued by an account and identified by code plus issuer. Requires a trustline. Codes are 1-12 alphanumeric characters (credit_alphanum4 or credit_alphanum12). Validate the issuer, not just the code."}, {"id": "claude_skills_assets_skill_liquidity_pool_shares", "label": "Liquidity Pool Shares", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Represent liquidity-pool positions. A trustline with liquidity_pool_use_count greater than 0 cannot be deleted until the position is withdrawn and the pool-share trustline is removed."}, {"id": "claude_skills_assets_skill_auth_required", "label": "AUTH_REQUIRED", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Flag Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users must be approved before they can receive the asset."}, {"id": "claude_skills_assets_skill_auth_revocable", "label": "AUTH_REVOCABLE", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Flag Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets the issuer freeze trustlines. When this flag and clawback are both set, confirm the issuer master key weight is 0 and identify who holds the SAC admin roles before listing the asset."}, {"id": "claude_skills_assets_skill_auth_immutable", "label": "AUTH_IMMUTABLE", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Flag Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes issuer flags permanent."}, {"id": "claude_skills_assets_skill_auth_clawback_enabled", "label": "AUTH_CLAWBACK_ENABLED", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Flag Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets the issuer claw back tokens. Operation.clawback requires this flag."}, {"id": "claude_skills_assets_skill_stellar_sdk", "label": "@stellar/stellar-sdk", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Identifiers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_assets_skill_horizon", "label": "Horizon", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Create Issuing Account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Account loads and transaction submission go through Horizon. The examples use the testnet server."}, {"id": "claude_skills_assets_skill_change_trust", "label": "ChangeTrust", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Trustlines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A positive limit creates a trustline and limit 0 deletes it. Removal fails with op_invalid_limit when balance or buying liabilities remain, and op_cannot_delete when a liquidity pool still uses the asset."}, {"id": "claude_skills_assets_skill_clawback", "label": "Clawback", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Clawback Tokens", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The issuer pulls tokens back from an account. This requires AUTH_CLAWBACK_ENABLED. A SAC admin can also forward clawback."}, {"id": "claude_skills_assets_skill_sep_0001", "label": "SEP-0001", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0001 (stellar.toml)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publish asset metadata in the domain's /.well-known/stellar.toml under CURRENCIES."}, {"id": "claude_skills_assets_skill_stellar_toml", "label": "stellar.toml", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0001 (stellar.toml)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing home_domain or CURRENCIES entry is not evidence of a scam. USDT0 ships without a stellar.toml. Validate by issuer and SAC derivation."}, {"id": "claude_skills_assets_skill_sep_0010", "label": "SEP-0010", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0010 (Web Authentication)", "source_url": "https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0010.md", "captured_at": null, "author": null, "contributor": null, "rationale": "Web authentication: the server makes a challenge transaction, the client signs it with a wallet, and the server checks the signature."}, {"id": "claude_skills_assets_skill_sep_0024", "label": "SEP-0024", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0024 (Hosted Deposit/Withdrawal)", "source_url": "https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0024.md", "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted fiat deposit and withdrawal. The anchor runs KYC and the fiat transfer in an interactive webview."}, {"id": "claude_skills_assets_skill_sep_0045", "label": "SEP-0045", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0045 (Web Auth for Contract Accounts)", "source_url": "https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0045.md", "captured_at": null, "author": null, "contributor": null, "rationale": "Extends SEP-10 to contract accounts (C... addresses) for smart-wallet and passkey anchor login. Draft; verify current status."}, {"id": "claude_skills_assets_skill_sep_0050", "label": "SEP-0050", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0050 (Non-Fungible Tokens)", "source_url": "https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0050.md", "captured_at": null, "author": null, "contributor": null, "rationale": "Standard contract interface for NFTs. Draft; verify current status. OpenZeppelin Stellar Contracts provide Base, Consecutive, and Enumerable reference implementations."}, {"id": "claude_skills_assets_skill_sep_7", "label": "SEP-7", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named with SEP-41 as a token-related SEP whose details live in the standards skill. This file does not describe SEP-7 further."}, {"id": "claude_skills_assets_skill_openzeppelin_stellar_contracts", "label": "OpenZeppelin Stellar Contracts", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SEP-0050 (Non-Fungible Tokens)", "source_url": "https://github.com/OpenZeppelin/stellar-contracts", "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_assets_skill_usdt0", "label": "USDT0", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production classic asset USDT0:GATISXX6BZ6NC7IKQBY37CJD4SOZL3CYZJWXEDG6JVIY4WBS6KXJHN6Q. Its SAC admin is a role-gated contract, a cross-chain bridge holds only the minter role, and it ships with no stellar.toml."}, {"id": "claude_skills_assets_skill_cap_0038", "label": "CAP-0038", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Remove Trustline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An asset trustline with liquidity_pool_use_count greater than 0 cannot be deleted."}, {"id": "claude_skills_assets_skill_sac_admin", "label": "SAC Admin", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": "https://developers.stellar.org/docs/build/guides/tokens/custom-sac-admin", "captured_at": null, "author": null, "contributor": null, "rationale": "A thin contract can drive SAC mint, burn, and clawback and keep classic ecosystem compatibility. USDT0's admin forwards mint, clawback, set_authorized, and set_admin. Call set_admin before locking the issuer: the admin starts as the issuer, and only the current admin can hand it over. Locking first leaves the admin stuck as the locked issuer."}, {"id": "claude_skills_assets_skill_lock_issuer", "label": "Lock Issuer", "file_type": "rationale", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Lock Issuing Account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set master weight to 0 so the issuer can never sign again. For a fixed supply, lock after distribution. For a SAC admin, an unlocked issuer can still mint by paying from the issuer account and bypass the contract roles. Lock only after set_admin."}, {"id": "claude_skills_assets_skill_set_admin", "label": "set_admin", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hands SAC admin from the issuer account to a contract. It must run while the issuer can still sign, before master weight is set to 0."}, {"id": "claude_skills_assets_skill_token_client", "label": "TokenClient", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Using SAC in Smart Contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "soroban_sdk TokenClient calls the SEP-41 interface on the SAC address. The example transfers after require_auth."}, {"id": "claude_skills_assets_skill_smart_contracts", "label": "smart-contracts skill", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the smart-contracts skill when classic assets are not enough and a custom token contract is required."}, {"id": "claude_skills_assets_skill_dapp", "label": "dapp skill", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI flows for trustline creation and asset display live in the dapp skill."}, {"id": "claude_skills_assets_skill_data", "label": "data skill", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Looking up balances and trustline state is delegated to the data skill."}, {"id": "claude_skills_assets_skill_standards", "label": "standards skill", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Related skills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token-related SEPs, named as SEP-41, SEP-7, and others, are looked up in the standards skill."}, {"id": "claude_skills_assets_skill_dex", "label": "DEX", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic assets integrate with the order-book DEX. That compatibility is a reason to stay on a Stellar asset plus a SAC admin instead of a custom token."}, {"id": "claude_skills_assets_skill_layerzero", "label": "layerzero.md", "file_type": "document", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The USDT0 cross-chain deployment, where the bridge holds only the minter role, is documented in cross-chain/layerzero.md."}, {"id": "claude_skills_assets_skill_issuing_account", "label": "Issuing Account", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Create Issuing Account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the issuing account separate from distribution. Payments from the issuer are minting. Consider multisig for the issuer."}, {"id": "claude_skills_assets_skill_distribution_account", "label": "Distribution Account", "file_type": "concept", "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Create Issuing Account", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The distributor opens a trustline, then receives the issued supply, so the issuer can be locked after distribution."}], "edges": [{"source": "claude_skills_assets_skill_xlm", "target": "claude_skills_assets_skill_stellar_assets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "weight": 1.0}, {"source": "claude_skills_assets_skill_credit_asset", "target": "claude_skills_assets_skill_stellar_assets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "weight": 1.0}, {"source": "claude_skills_assets_skill_liquidity_pool_shares", "target": "claude_skills_assets_skill_stellar_assets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "weight": 1.0}, {"source": "claude_skills_assets_skill_credit_asset", "target": "claude_skills_assets_skill_trustlines", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Asset Types", "weight": 1.0}, {"source": "claude_skills_assets_skill_trustlines", "target": "claude_skills_assets_skill_credit_asset", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Check Trustline Status", "weight": 1.0}, {"source": "claude_skills_assets_skill_sac", "target": "claude_skills_assets_skill_sep_41", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "SAC vs Custom Token Interface", "weight": 1.0}, {"source": "claude_skills_assets_skill_contract_tokens", "target": "claude_skills_assets_skill_sep_41", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Overview", "weight": 1.0}, {"source": "claude_skills_assets_skill_sac", "target": "claude_skills_assets_skill_stellar_assets", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Stellar Asset Contract (SAC)", "weight": 1.0}, {"source": "claude_skills_assets_skill_contract_tokens", "target": "claude_skills_assets_skill_sac", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "weight": 1.0}, {"source": "claude_skills_assets_skill_stellar_assets", "target": "claude_skills_assets_skill_contract_tokens", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "Overview", "weight": 1.0}, {"source": "claude_skills_assets_skill_sac_admin", "target": "claude_skills_assets_skill_sac", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/assets/SKILL.md", "source_location": "When to Use What", "weight": 1.0}, {"source": "claude_skills_assets_skill_usdt0", "target": "clau