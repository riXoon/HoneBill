{
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "packages/*"
  ],
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@nestjs/throttler": "^6.7.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@upstash/redis": "^1.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.9"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "prepare": "node -e \"if (process.env.CI !== 'true') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\"",
    "lint-staged": "lint-staged",
    "build:sdk": "npm install && npm run build --workspace=pijin_core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,tsx}": [],
    "packages/pijin_core/**/*.ts": [],
    "apps/backend/**/*.{js,jsx}": [],
    "apps/mobile/**/*.{js,jsx,ts,tsx}": [],
    "contracts/**/*.rs": "cargo fmt --manifest-path contracts/Cargo.toml --"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
