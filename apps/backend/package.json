{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run prisma:generate",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e:phase2": "jest --config ./test/jest-e2e.json --runTestsByPath ./test/phase2-contract-parity.e2e-spec.ts ./test/sep10-guard.e2e-spec.ts --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:phase2": "jest --runTestsByPath src/phase2-smoke.spec.ts --runInBand",
    "test:phase2:watch": "jest --watch --runTestsByPath src/phase2-smoke.spec.ts --runInBand",
    "test:phase3": "jest --runTestsByPath src/scripts/phase3-wallet-smoke.spec.ts src/modules/wallet/wallet.service.spec.ts src/modules/settlements/settlements.service.spec.ts src/modules/settlements/reconciliation.service.spec.ts src/scripts/reconciliation.test.ts --runInBand",
    "test:phase3:watch": "jest --watch --runTestsByPath src/scripts/phase3-wallet-smoke.spec.ts src/modules/wallet/wallet.service.spec.ts src/modules/settlements/settlements.service.spec.ts src/modules/settlements/reconciliation.service.spec.ts src/scripts/reconciliation.test.ts --runInBand",
    "phase3:script": "node -r ts-node/register ./src/scripts/phase3-wallet-smoke.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.61.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.8.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pijin_core": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transform": {
    "^.+\\.[tj]sx?$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
  },
   "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/jwt|THE-PACKAGE-FROM-THE-ERROR)/)"
  ],
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
