{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci --ignore-scripts",
  "buildCommand": "cd ../.. && npm run build --workspace=pijin_core && cd apps/backend && npx prisma generate && npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,prisma/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
